<compatibility-matrix version="1.0" type="framework">
    <!-- ⚠️ 故意不写 level 属性：
         libvintf 的 checkMatrixHalsHasDefinition()（VintfObject.cpp:1358）对
         level==UNSPECIFIED 的矩阵片段直接跳过。原厂/底层厂商的私有接口定义
         不在 AOSP 树里（vendor/qcom/opensource/interfaces 只覆盖一小部分），
         一旦给片段写上 level，整份合并矩阵（含 QTI 共享矩阵的 200+ 条目）
         都会被要求“每个接口都有定义模块”，必然失败（2026-10-11 踩过）。
         兼容性检查 check_vintf_compatible 仍然会读无 level 的片段，所以有效。 -->
    <!-- 原厂 vendor 侧私有 AIDL HAL（Lenovo/Motorola/Dolby/QTI）。
         AOSP 的 framework 矩阵不含它们，check_vintf_compatible 要求显式声明；
         用 optional="true" 表示「框架不依赖、但允许存在」。
         由 scripts/gen-fcm-fragment.py 生成（2026-10-11）。 -->
    <hal format="aidl" optional="true">
        <name>lenovo.hardware.ai</name>
        <version>1</version>
        <interface>
            <name>IDevice</name>
            <instance>default</instance>
