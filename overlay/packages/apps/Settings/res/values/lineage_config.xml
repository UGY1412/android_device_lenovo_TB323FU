<?xml version="1.0" encoding="utf-8"?>
<!--
  TB323FU device resource overlay for com.android.settings (static, merged
  into Settings.apk).

  Exposes the refresh-rate pickers in Settings > Display:
    - max_refresh_rate  -> PeakRefreshRateListPreferenceController
      ("Peak refresh rate" / 最高刷新率: list of the panel's supported modes,
      built from Display.getSupportedModes() => 165 / 144 / 120 / 90 / 60 Hz)
    - min_refresh_rate  -> MinRefreshRatePreferenceController
      ("Minimum refresh rate" / 最小刷新率)

  Both are gated by LineageOS booleans that default to false in
  packages/apps/Settings/res/values/lineage_config.xml.
-->
<resources>
    <bool name="config_show_peak_refresh_rate_switch">true</bool>
    <bool name="config_show_min_refresh_rate_switch">true</bool>
</resources>
